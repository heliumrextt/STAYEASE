<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= listing.title %> | STAYEASE
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    body {
      background: linear-gradient(135deg, #ffe3e8 0%, #e8f0ff 100%);
    }

    .show-card {
      border: none;
      border-radius: 1.25rem;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    }

    .hero-img {
      width: 100%;
      height: 24rem;
      object-fit: cover;
    }

    .hero-placeholder {
      height: 24rem;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #e9ecef;
      color: #6c757d;
      font-size: 1.1rem;
    }

    .price-tag {
      font-size: 1.6rem;
      font-weight: 700;
      color: #fe424d;
    }

    .info-chip {
      display: inline-block;
      background: #f1f3f5;
      border-radius: 2rem;
      padding: 0.35rem 0.9rem;
      margin: 0 0.4rem 0.4rem 0;
      font-size: 0.95rem;
    }

    .btn-brand {
      background: #fe424d;
      border: none;
      color: #fff;
      font-weight: 600;
      border-radius: 0.75rem;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .btn-brand:hover {
      background: #e23642;
      color: #fff;
      transform: translateY(-2px);
      box-shadow: 0 6px 14px rgba(254, 66, 77, 0.4);
    }

    .btn-delete {
      border-radius: 0.75rem;
      font-weight: 600;
    }
  </style>
</head>
<% if (currentUser && listing.owner && listing.owner.equals(currentUser._id)) { %>
  <!-- your Edit and Delete buttons -->
  <% } %>

    <body class="d-flex flex-column min-vh-100">


      <div class="container flex-grow-1 py-5">
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8">

            <a href="/listings" class="text-decoration-none text-dark d-inline-block mb-3">
              &larr; Back to all listings
            </a>

            <div class="card show-card">

              <% if (listing.image && listing.image.url) { %>
                <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="hero-img" />
                <% } else { %>
                  <div class="hero-placeholder">No image available</div>
                  <% } %>

                    <div class="card-body p-4 p-md-5">
                      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                        <h2 class="fw-bold mb-0">
                          <%= listing.title %>
                        </h2>
                        <div class="price-tag">
                          &#8377;<%= listing.price.toLocaleString("en-IN") %>
                            <small class="text-muted fs-6 fw-normal">/ night</small>
                        </div>
                      </div>

                      <div class="mb-3">
                        <span class="info-chip">&#128205; <%= listing.location %></span>
                        <span class="info-chip">&#127758; <%= listing.country %></span>
                      </div>

                      <hr />

                      <h5 class="fw-semibold">About this place</h5>
                      <p class="text-secondary">
                        <%= listing.description %>
                      </p>

                      <hr />

                      <div class="d-flex gap-2 flex-wrap">
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-brand px-4">Edit Listing</a>

                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE"
                          onsubmit="return confirm('Are you sure you want to delete this listing?');">
                          <button type="submit" class="btn btn-outline-danger btn-delete px-4">Delete Listing</button>
                        </form>
                      </div>
                    </div>
            </div>

          </div>
        </div>
      </div>

      <%- include('../includes/footer') %>
    </body>

</html>