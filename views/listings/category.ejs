<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>
    <%= info.title %> Stays | STAYEASE
  </title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

  <style>
    .cat-hero {
      color: #fff;
      text-align: center;
      padding: 5rem 1rem;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-color: #333;
    }

    .cat-hero .emoji {
      font-size: 3.5rem;
    }

    .cat-hero h1 {
      font-weight: 800;
      margin: 0.5rem 0;
    }

    .cat-hero p {
      font-size: 1.1rem;
      opacity: 0.95;
      margin-bottom: 0.5rem;
    }

    .count-pill {
      display: inline-block;
      background: rgba(255, 255, 255, 0.25);
      padding: 0.3rem 1rem;
      border-radius: 2rem;
      font-weight: 600;
    }

    .stay-card {
      border: none;
      border-radius: 1rem;
      overflow: hidden;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .stay-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
    }

    .stay-card img {
      width: 100%;
      height: 14rem;
      object-fit: cover;
    }

    .price {
      color: #fe424d;
      font-weight: 700;
    }

    .stay-link {
      color: inherit;
      text-decoration: none;
      display: block;
      height: 100%;
    }

    .stay-link:focus-visible {
      outline: 3px solid #fe424d;
      outline-offset: 3px;
      border-radius: 1rem;
    }
  </style>
</head>

<body class="d-flex flex-column min-vh-100">

  <%- include('../includes/navbar') %>

    <% const t=info.title.toLowerCase(); let bg="" ; if (t.includes("beach")) bg="/images/beach.webp" ; else if
      (t.includes("mountain")) bg="/images/mountain.webp" ; else if (t.includes("villa")) bg="/images/villa.webp" ; else
      if (t.includes("heritage")) bg="/images/heritage.webp" ; %>

      <section class="cat-hero" style="<%= bg ? `background-image: url('${bg}');` : `background: ${info.gradient};` %>">


        <div class=" emoji">
          <%= info.emoji %>
        </div>

        <h1>
          <%= info.title %> Stays
        </h1>

        <p>
          <%= info.tagline %>
        </p>

        <span class="count-pill">
          <%= listings.length %>
            <%= listings.length===1 ? "place" : "places" %> to stay
        </span>
      </section>

      <main class="container flex-grow-1 py-5">

        <% if (listings.length===0) { %>

          <div class="text-center py-5">
            <h4>No <%= info.title.toLowerCase() %> stays yet</h4>

            <p class="text-muted">
              Be the first to add a stay in this category.
            </p>

            <a href="/listings/new" class="btn btn-danger mt-3">
              Add the First Stay
            </a>
          </div>

          <% } else { %>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">

              <% for (const listing of listings) { %>

                <div class="col">

                  <a href="/listings/<%= listing._id %>" class="stay-link" aria-label="View <%= listing.title %>">

                    <div class="card stay-card h-100">

                      <% if (listing.image && listing.image.url) { %>

                        <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="card-img-top"
                          loading="lazy" />

                        <% } else { %>

                          <div class="d-flex align-items-center justify-content-center bg-light text-muted"
                            style="height: 14rem;">
                            <span>No image available</span>
                          </div>

                          <% } %>

                            <div class="card-body">

                              <h6 class="card-title fw-bold mb-1">
                                <%= listing.title %>
                              </h6>

                              <p class="text-muted small mb-2">
                                <%= listing.location %>, <%= listing.country %>
                              </p>

                              <p class="price mb-0">
                                &#8377;<%= Number(listing.price || 0).toLocaleString("en-IN") %>
                                  <small class="text-muted fw-normal">/ night</small>
                              </p>

                            </div>

                    </div>

                  </a>

                </div>

                <% } %>

            </div>

            <% } %>

      </main>

      <%- include('../includes/footer') %>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
        </script>

</body>

</html>