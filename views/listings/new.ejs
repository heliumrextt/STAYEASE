<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Listing | STAYEASE</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    body {
      background: linear-gradient(135deg, #ffe3e8 0%, #e8f0ff 100%);
    }

    .form-card {
      border: none;
      border-radius: 1.25rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    }

    .form-title {
      font-weight: 700;
      letter-spacing: 0.5px;
    }

    .btn-brand {
      background: #fe424d;
      border: none;
      color: #fff;
      font-weight: 600;
      padding: 0.75rem;
      border-radius: 0.75rem;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .btn-brand:hover {
      background: #e23642;
      color: #fff;
      transform: translateY(-2px);
      box-shadow: 0 6px 14px rgba(254, 66, 77, 0.4);
    }

    .form-control:focus {
      border-color: #fe424d;
      box-shadow: 0 0 0 0.2rem rgba(254, 66, 77, 0.2);
    }

    #preview {
      display: none;
      max-height: 14rem;
      object-fit: cover;
      width: 100%;
      border-radius: 0.75rem;
    }
  </style>
</head>

<body class="d-flex flex-column min-vh-100">


  <div class="container flex-grow-1 py-5">
    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-6">

        <div class="card form-card p-4 p-md-5">
          <h3 class="text-center form-title mb-1">Create a New Listing</h3>
          <p class="text-center text-muted mb-4">Tell travellers about your place</p>

          <form method="POST" action="/listings">

            <div class="form-floating mb-3">
              <input name="listing[title]" id="title" class="form-control" placeholder="Title" type="text" required />
              <label for="title">Title</label>
            </div>

            <div class="form-floating mb-3">
              <textarea name="listing[description]" id="description" class="form-control" placeholder="Description"
                style="height: 120px" required></textarea>
              <label for="description">Description</label>
            </div>

            <div class="form-floating mb-2">
              <input name="listing[image]" id="image" class="form-control" placeholder="Image URL" type="text" />
              <label for="image">Image URL / Link</label>
            </div>
            <img id="preview" alt="Image preview" class="mb-3" />

            <div class="input-group mb-3 mt-3">
              <span class="input-group-text">&#8377;</span>
              <div class="form-floating">
                <input name="listing[price]" id="price" class="form-control" placeholder="Price" type="number" min="0"
                  required />
                <label for="price">Price per night</label>
              </div>
            </div>

            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <div class="form-floating">
                  <input name="listing[country]" id="country" class="form-control" placeholder="Country" type="text"
                    required />
                  <label for="country">Country</label>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-floating">
                  <input name="listing[location]" id="location" class="form-control" placeholder="Location" type="text"
                    required />
                  <label for="location">Location</label>
                </div>
              </div>
            </div>

            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-brand">Add Listing</button>
              <a href="/listings" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </form>
        </div>

      </div>
    </div>
  </div>

  <%- include('../includes/footer') %>

    <script>
      const imageInput = document.getElementById("image");
      const preview = document.getElementById("preview");

      imageInput.addEventListener("input", () => {
        const url = imageInput.value.trim();
        if (url) {
          preview.src = url;
          preview.style.display = "block";
        } else {
          preview.style.display = "none";
        }
      });
      preview.addEventListener("error", () => {
        preview.style.display = "none";
      });
    </script>
</body>

</html>